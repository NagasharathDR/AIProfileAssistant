SECRET_KEY=replace-with-a-local-secret
DEBUG=False
DATABASE_URI=sqlite:///default.db
PROFILE_SOURCE_DIR=data/profile_sources
# Optional absolute path overrides for either fixed source file:
# PROFILE_LINKEDIN_PDF=C:/path/to/linkedin_profile.pdf
# PROFILE_RESUME_PDF=C:/path/to/resume.pdf
PROFILE_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*

# Gemini configuration for LLM-based routing and answer correction
GEMINI_API_KEY=your_gemimi_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com